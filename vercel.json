{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/accreditation-umalusi",
      "destination": "/academics.html#standards",
      "permanent": true
    },
    {
      "source": "/admissions",
      "destination": "/admissions.html",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/school-life.html",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/culture",
      "destination": "/school-life.html#creative-learning",
      "permanent": true
    },
    {
      "source": "/extra-curricular",
      "destination": "/school-life.html",
      "permanent": true
    },
    {
      "source": "/fee-structure",
      "destination": "/admissions.html?view=fees#fees",
      "permanent": true
    },
    {
      "source": "/fet",
      "destination": "/matric.html",
      "permanent": true
    },
    {
      "source": "/foundation-phase",
      "destination": "/early-years.html",
      "permanent": true
    },
    {
      "source": "/get",
      "destination": "/senior.html",
      "permanent": true
    },
    {
      "source": "/high",
      "destination": "/academics.html#learning-phases",
      "permanent": true
    },
    {
      "source": "/intermediate-phase",
      "destination": "/intermediate.html",
      "permanent": true
    },
    {
      "source": "/literacy-program",
